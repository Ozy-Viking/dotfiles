# If not running interactively, don't do anything.
[[ $- != *i* ]] && return

[[ -r "$HOME/.config/shell/env.sh" ]] && source "$HOME/.config/shell/env.sh"
[[ -r "$HOME/.config/shell/interactive.sh" ]] && source "$HOME/.config/shell/interactive.sh"
[[ -r "$HOME/.config/shell/bash.sh" ]] && source "$HOME/.config/shell/bash.sh"
