#!/usr/bin/env bash
set -euo pipefail

dry_run=false

if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=true
  shift
fi

direction="${1:-}"

case "$direction" in
  l|r|u|d) ;;
  *) exit 2 ;;
esac

active_json="$(hyprctl activewindow -j)"
clients_json="$(hyprctl clients -j)"
active_address="$(jq -r '.address // empty' <<<"$active_json")"

[[ -n "$active_address" ]] || exit 0

wrap_result="$(jq -r --arg direction "$direction" --arg active_address "$active_address" --argjson active "$active_json" '
  def center($window): {
    x: ($window.at[0] + ($window.size[0] / 2)),
    y: ($window.at[1] + ($window.size[1] / 2))
  };

  def with_center_and_delta($active_center):
    center(.) as $candidate_center
    | . + {
        __cx: $candidate_center.x,
        __cy: $candidate_center.y,
        __dx: ($candidate_center.x - $active_center.x),
        __dy: ($candidate_center.y - $active_center.y)
      };

  def debug_candidate:
    {
      address,
      class,
      title,
      monitor,
      workspace: .workspace.name,
      at,
      size,
      center: { x: .__cx, y: .__cy },
      delta: { x: .__dx, y: .__dy },
      primary: .__primary,
      secondary: .__secondary
    };

  def active_debug($active_center):
    {
      address: $active.address,
      class: $active.class,
      title: $active.title,
      monitor: $active.monitor,
      workspace: $active.workspace.name,
      at: $active.at,
      size: $active.size,
      center: $active_center
    };

  center($active) as $active_center |
  ([
    .[]
    | select(.address != $active_address)
    | select((.mapped // true) == true)
    | select((.hidden // false) == false)
    | with_center_and_delta($active_center)
    | . + {
        __primary: (if $direction == "l" then -.__cx elif $direction == "r" then .__cx elif $direction == "u" then -.__cy else .__cy end),
        __secondary: (if ($direction == "l" or $direction == "r") then .__cy else .__cx end)
      }
  ] | sort_by(.__primary, .__secondary)) as $wrap_candidates |
  if ($wrap_candidates | length) > 0 then
    {
      mode: "global-wrap",
      direction: $direction,
      active: active_debug($active_center),
      target: ($wrap_candidates[0] | debug_candidate),
      wrapCandidates: ($wrap_candidates | map(debug_candidate))
    }
  else
    {
      mode: "none",
      direction: $direction,
      active: active_debug($active_center),
      target: null,
      wrapCandidates: []
    }
  end
' <<<"$clients_json")"

if [[ "$dry_run" == true ]]; then
  jq '. + {
    nativeBehavior: "normal run first uses hyprctl dispatch movefocus; global-wrap target is used only if native focus crosses opposite to the requested direction or does not move"
  }' <<<"$wrap_result"
  exit 0
fi

hyprctl --batch "dispatch movefocus $direction" >/dev/null
new_active_json="$(hyprctl activewindow -j)"
new_active_address="$(jq -r '.address // empty' <<<"$new_active_json")"

if [[ -n "$new_active_address" && "$new_active_address" != "$active_address" ]]; then
  moved_in_requested_direction="$(jq -r --arg direction "$direction" --argjson before "$active_json" --argjson after "$new_active_json" '
    def center($window): {
      x: ($window.at[0] + ($window.size[0] / 2)),
      y: ($window.at[1] + ($window.size[1] / 2))
    };

    center($before) as $before_center |
    center($after) as $after_center |
    ($after_center.x - $before_center.x) as $dx |
    ($after_center.y - $before_center.y) as $dy |
    ($direction == "l" and $dx < 0) or
    ($direction == "r" and $dx > 0) or
    ($direction == "u" and $dy < 0) or
    ($direction == "d" and $dy > 0)
  ' <<<"{}")"

  [[ "$moved_in_requested_direction" == "true" ]] && exit 0
fi

target="$(jq -r '.target.address // empty' <<<"$wrap_result")"

[[ -n "$target" ]] || exit 0

hyprctl dispatch focuswindow "address:$target"
